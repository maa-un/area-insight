{
  "name": "area-insight",
  "version": "0.2.5",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @area-insight/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @area-insight/shared build && pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
